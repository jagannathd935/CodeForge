# =====================================================================
# CodeForge Deployment & Environment Configuration Template (.env.example)
# IMPORTANT: Do NOT store real credentials in this template.
# Copy this file to .env and provide your deployment-specific secrets.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8.0+)
# ---------------------------------------------------------------------
# In local development: port 3307 is used with workspace mysql-data
# In production: supply secure remote host and credentials
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/codeforge_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_db_username_placeholder
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_placeholder

# ---------------------------------------------------------------------
# JWT Authentication Security
# ---------------------------------------------------------------------
# 256-bit Base64-encoded signing key (Never commit production secret!)
JWT_SECRET=YOUR_BASE64_ENCODED_256BIT_SECRET_KEY_PLACEHOLDER
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------
# Server, URLs, and CORS Configuration
# ---------------------------------------------------------------------
SERVER_PORT=8080
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (consumed during build / runtime)
VITE_API_URL=http://localhost:8080/api

# ---------------------------------------------------------------------
# Code Execution & Isolation Sandbox Settings
# ---------------------------------------------------------------------
# Set to 'true' if Docker engine daemon is installed and running
CODEFORGE_EXECUTION_DOCKER_ENABLED=false
CODEFORGE_EXECUTION_TIMEOUT_MS=5000
CODEFORGE_EXECUTION_MEMORY_LIMIT_MB=256
CODEFORGE_EXECUTION_MAX_CONCURRENCY=4
CODEFORGE_EXECUTION_TEMP_DIR=./temp-submissions

# ---------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CODEFORGE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN
